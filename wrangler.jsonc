{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yupiii-dev",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-12",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Variables públicas (no secretas). Los secretos van con `wrangler secret put` o .dev.vars
  "vars": {
    "APP_NAME": "YupiEd",
    "SUPABASE_URL": "http://127.0.0.1:54321",
    "SUPABASE_PUBLISHABLE_KEY": "",
    "R2_BUCKET_NAME": "yupiii-files-dev",
    "R2_ACCOUNT_ID": "",
    "MAX_UPLOAD_MB": "200",
    "PORTAL_URL": "http://localhost:8788"
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "yupiii-files-dev" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "env": {
    "production": {
      "name": "yupiii",
      // Dominio de YupiEd Chile (Custom Domain del Worker).
      // Crea solo un registro para este host; no toca MX/SPF/DKIM/DMARC.
      "routes": [{ "pattern": "yupied.cl.yupicct.com", "custom_domain": true }],
      "vars": {
        "APP_NAME": "YupiEd",
        "SUPABASE_URL": "https://ifbmxalfqiyqlqdpenbo.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_PBDo9bLzBrQjQIFhvZQZ4g_ZSOSaW2R",
        "R2_BUCKET_NAME": "yupiii-files-prod",
        "R2_ACCOUNT_ID": "",
        "MAX_UPLOAD_MB": "200",
        // Portal estático (Cloudflare Pages, proyecto yupied-portal)
        "PORTAL_URL": "https://yupied.yupicct.com"
      },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "yupiii-files-prod" }],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
